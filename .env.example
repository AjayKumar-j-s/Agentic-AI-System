DATABASE_URL=sqlite:///./agentic_support.db
REFUND_LIMIT_USD=75
MAX_WORKFLOW_STEPS=8
ESCALATE_INTENT_CONFIDENCE_BELOW=0.4

# Gemini (required). Used for routing + reasoning + responses.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Admin API (required only if you use /config/* endpoints)
ADMIN_API_KEY=CHANGE_ME

# Optional: OpenTelemetry export (set to enable OTLP traces)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=agentic-support
